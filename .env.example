# ── Core ─────────────────────────────────────────────
DATABASE_URL="postgresql://autobartje:autobartje@localhost:5432/autobartje"
# Hosted Postgres with a connection pooler (Supabase, Neon): DATABASE_URL is the pooled URL the app uses,
# DIRECT_URL the direct/session URL that migrations need. Leave DIRECT_URL empty for a plain local database.
DIRECT_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 32+ random bytes: `openssl rand -base64 32`
AUTH_SECRET=""
# Key for encrypting TOTP secrets and other sensitive fields: `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=""

# ── Seed (first owner account) ───────────────────────
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="change-me-now-please"
SEED_DEMO="true"

# ── Cloudflare R2 (S3-compatible) ────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PRIVATE_BUCKET="autobartje-private"
R2_PUBLIC_BUCKET="autobartje-public"
# Public bucket URL for site images and logo, e.g. https://media.example.com
R2_PUBLIC_URL=""

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="autobartje <no-reply@example.com>"

# ── SMS / WhatsApp (Infobip) ─────────────────────────
SMS_PROVIDER="console"   # console | infobip
INFOBIP_BASE_URL=""
INFOBIP_API_KEY=""
INFOBIP_SENDER="autobartje"
DISPATCH_ALERT_PHONE=""  # on-call dispatcher, E.164

# ── Google Maps ──────────────────────────────────────
# Browser key (restrict to your domain + Places/Maps JavaScript API)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
# Server key (restrict to server IPs + Distance Matrix / Routes API)
GOOGLE_MAPS_SERVER_KEY=""

# ── Cloudflare Turnstile ─────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Web push (admin alerts) ──────────────────────────
# `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@example.com"

# ── Analytics (loaded only after cookie consent) ─────
NEXT_PUBLIC_GA_ID=""

# ── Sentry ───────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ── Cron (Vercel sends this as a Bearer token) ───────
CRON_SECRET=""                 # Vercel Cron sends it as "Authorization: Bearer ..."
NOTIFY_DRY_RUN=""              # "1" = log SMS/email instead of sending (staging, CI)

# ── Stripe (phase 2) ─────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Private files (inspection photos, signatures) on disk when R2 is not configured
# LOCAL_STORAGE_DIR=/var/lib/autobartje/files

# WhatsApp Business (Meta Cloud API). Without WHATSAPP_PROVIDER=meta, WhatsApp customers get SMS.
WHATSAPP_PROVIDER=""            # meta
WHATSAPP_TOKEN=""               # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="order_update"
WHATSAPP_APP_SECRET=""          # signs the status webhook
WHATSAPP_VERIFY_TOKEN=""        # any random string, also entered in the Meta app dashboard

# Partner API webhooks go only to public https URLs. Set to 1 in development to allow
# http://localhost receivers (ignored on Vercel production).
WEBHOOK_ALLOW_PRIVATE=""
